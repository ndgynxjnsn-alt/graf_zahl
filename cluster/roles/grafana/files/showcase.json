{
  "uid": "graf-zahl-cluster",
  "title": "Graf Zahl \u2014 HA Cluster (multi-tenant)",
  "tags": [
    "showcase",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "custom",
        "query": "production,test",
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "test",
            "value": "test",
            "selected": false
          }
        ],
        "current": {
          "text": "production",
          "value": "production"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Golden signals \u2014 $tenant",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "sum(rate(http_server_request_duration_count{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "100 * sum(rate(http_server_request_duration_count{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\", http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_count{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}[$__rate_interval])), 0.0001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_bucket{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}[$__rate_interval])) by (le))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "JVM heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "sum(jvm_memory_used{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\", jvm_memory_type=\"heap\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          },
          "links": [
            {
              "title": "Open CPU flame graph for $tenant (Pyroscope, this time range)",
              "targetBlank": true,
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22prof%22%3A%7B%22datasource%22%3A%22pyroscope-${tenant}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22grafana-pyroscope-datasource%22%2C%22uid%22%3A%22pyroscope-${tenant}%22%7D%2C%22queryType%22%3A%22profile%22%2C%22profileTypeId%22%3A%22process_cpu%3Acpu%3Ananoseconds%3Acpu%3Ananoseconds%22%2C%22labelSelector%22%3A%22%7Bservice_name%3D%5C%22graf-zahl-demo%5C%22%2C%20environment%3D%5C%22$tenant%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            }
          ]
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_count{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 by route  \u2014  click an exemplar (\u25c6) to open the trace",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Custom app metric \u2014 work duration p95 (Micrometer \u2192 OTLP)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(app_work_duration_bucket{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "work p95",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM memory & threads",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-${tenant}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          },
          "links": [
            {
              "title": "Open CPU flame graph for $tenant (Pyroscope, this time range)",
              "targetBlank": true,
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22prof%22%3A%7B%22datasource%22%3A%22pyroscope-${tenant}%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22grafana-pyroscope-datasource%22%2C%22uid%22%3A%22pyroscope-${tenant}%22%7D%2C%22queryType%22%3A%22profile%22%2C%22profileTypeId%22%3A%22process_cpu%3Acpu%3Ananoseconds%3Acpu%3Ananoseconds%22%2C%22labelSelector%22%3A%22%7Bservice_name%3D%5C%22graf-zahl-demo%5C%22%2C%20environment%3D%5C%22$tenant%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            }
          ]
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-${tenant}"
          },
          "expr": "sum by (jvm_memory_type) (jvm_memory_used{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"})",
          "legendFormat": "mem {{jvm_memory_type}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs \u2014 $tenant (trace_id links to Tempo)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "logs",
      "title": "Application logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-${tenant}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-${tenant}"
          },
          "expr": "{service_name=\"graf-zahl-demo\", deployment_environment=\"$tenant\"}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traces \u2014 $tenant",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "table",
      "title": "Recent traces (click a Trace ID to open the trace view)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo-${tenant}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo-${tenant}"
          },
          "queryType": "traceql",
          "query": "{ resource.deployment.environment = \"$tenant\" }",
          "tableType": "traces",
          "limit": 20
        }
      ]
    },
    {
      "type": "row",
      "title": "Continuous profiling (Pyroscope) \u2014 $tenant",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      }
    },
    {
      "type": "flamegraph",
      "title": "CPU profile",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "pyroscope-${tenant}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "pyroscope-${tenant}"
          },
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"graf-zahl-demo\", environment=\"$tenant\"}"
        }
      ]
    }
  ]
}