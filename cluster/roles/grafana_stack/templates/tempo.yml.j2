# {{ ansible_managed }}
# Tempo — clustered (distributor/ingester memberlist ring), multi-tenant, S3 (Garage).
multitenancy_enabled: true
stream_over_http_enabled: true

server:
  http_listen_port: {{ ports.tempo_http }}
  grpc_listen_port: {{ ports.tempo_grpc }}
  log_level: warn

distributor:
  receivers:
    otlp:
      protocols:
        http:
          endpoint: "0.0.0.0:{{ ports.tempo_otlp_http }}"    # moved off 4318 (Alloy owns it)
        grpc:
          endpoint: "0.0.0.0:{{ ports.tempo_otlp_grpc }}"
  ring:
    kvstore: { store: memberlist }
    instance_addr: {{ node_ip }}           # advertise LAN IP (nodes use eth1, not eth0)

ingester:
  lifecycler:
    address: {{ node_ip }}                 # advertise LAN IP in the ring
    ring:
      kvstore: { store: memberlist }
      replication_factor: {{ ring_replication_factor }}
  max_block_duration: 5m

# Gossip ring: distinct bind port (Tempo=7948) + join the 3 nodes.
# rejoin_interval periodically re-joins so the ring heals even when the nodes
# restart at different times (Tempo doesn't retry the initial join for long).
memberlist:
  bind_port: {{ ports.tempo_memberlist }}
  advertise_addr: {{ node_ip }}
  cluster_label: "tempo"   # isolate this app's gossip from the others
  rejoin_interval: 30s
  abort_if_cluster_join_fails: false
  join_members:
{% for n in cluster_nodes %}
    - {{ n.ip }}:{{ ports.tempo_memberlist }}
{% endfor %}

storage:
  trace:
    backend: s3
    s3:
      endpoint: {{ node_ip }}:{{ ports.garage_s3 }}
      bucket: tempo
      access_key: {{ garage_s3_key_id }}
      secret_key: {{ garage_s3_secret }}
      region: {{ garage_s3_region }}
      forcepathstyle: true
      insecure: true
    wal:
      path: {{ ssd_mount }}/tempo/wal

compactor:
  ring:
    kvstore: { store: memberlist }
    instance_addr: {{ node_ip }}
  compaction:
    block_retention: 168h

metrics_generator:
  ring:
    kvstore: { store: memberlist }
    instance_addr: {{ node_ip }}
  registry:
    external_labels:
      source: tempo
  storage:
    path: {{ ssd_mount }}/tempo/generator-wal
    remote_write:
      - url: http://{{ node_ip }}:{{ ports.mimir_http }}/api/v1/push
        send_exemplars: true

overrides:
  defaults:
    metrics_generator:
      processors: [service-graphs, span-metrics]
