# {{ ansible_managed }}
# Pyroscope — clustered (memberlist ring), multi-tenant, S3 (Garage).
# The per-ring instance addresses are passed as CLI flags in the compose file
# (that path is proven); this file carries storage, tenancy and gossip.
multitenancy_enabled: true

server:
  http_listen_port: {{ ports.pyroscope_http }}
  grpc_listen_port: {{ ports.pyroscope_grpc }}
  log_level: warn

# Gossip ring: distinct bind port (Pyroscope=7949) + join the 3 nodes.
# rejoin_interval periodically re-joins so the ring heals after staggered restarts.
memberlist:
  bind_port: {{ ports.pyroscope_memberlist }}
  advertise_addr: {{ node_ip }}
  cluster_label: "pyroscope"   # isolate this app's gossip from the others
  rejoin_interval: 30s
  abort_if_cluster_join_fails: false
  join_members:
{% for n in cluster_nodes %}
    - {{ n.ip }}:{{ ports.pyroscope_memberlist }}
{% endfor %}

storage:
  backend: s3
  s3:
    endpoint: {{ node_ip }}:{{ ports.garage_s3 }}
    bucket_name: pyroscope
    access_key_id: {{ garage_s3_key_id }}
    secret_access_key: {{ garage_s3_secret }}
    region: {{ garage_s3_region }}
    insecure: true
    force_path_style: true
