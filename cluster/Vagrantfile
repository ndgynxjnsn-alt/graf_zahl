# -*- mode: ruby -*-
# Graf Zahl HA cluster — 3 scaled-down VMs for local development.
#
# The VMs mirror the real hardware topology (3 identical nodes, each with
# 1 SSD + 4 HDDs, fixed IPs) but with tiny RAM/disks so a laptop can run them.
# The *_DEV numbers below are the only thing you shrink; production hardware
# has dozens of GB of RAM and multi-TB disks (bump the constants, nothing else).
#
#   vagrant up
#   ansible-playbook -i inventory.ini site.yml
#
require 'yaml'
require 'fileutils'

settings = YAML.load_file(File.join(__dir__, 'group_vars', 'all.yml'))
NODES    = settings['cluster_nodes']

BOX        = 'bento/ubuntu-26.04'   # Ubuntu 26.04 "Resolute Raccoon", VirtualBox
NODE_MEM   = 2048                    # DEV: 2 GB   (prod: dozens of GB)
NODE_CPUS  = 2
SSD_MB     = 2048                    # DEV SSD 2 GB (prod: real SSD)
HDD_MB     = 1024                    # DEV HDD 1 GB each (prod: multi-TB)
NUM_HDD    = 4

Vagrant.configure('2') do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false
  # bento ships a vagrant user + insecure key; keep it for the dev cluster.
  config.ssh.insert_key = false

  NODES.each do |node|
    config.vm.define node['name'] do |n|
      n.vm.hostname = node['name']
      # Private, fixed-IP NIC (becomes eth1 inside the guest → keepalived + gossip).
      n.vm.network 'private_network', ip: node['ip']

      n.vm.provider 'virtualbox' do |vb|
        vb.name   = "grafzahl-#{node['name']}"
        vb.memory = NODE_MEM
        vb.cpus   = NODE_CPUS
        vb.linked_clone = true

        # ---- Extra disks: 1 SSD + 4 HDDs, attached to the SATA controller ----
        disk_dir = File.join(__dir__, '.disks', node['name'])
        FileUtils.mkdir_p(disk_dir)
        disks = [['ssd', SSD_MB]]
        (1..NUM_HDD).each { |i| disks << ["hdd#{i}", HDD_MB] }

        disks.each_with_index do |(dname, size_mb), idx|
          file = File.join(disk_dir, "#{dname}.vdi")
          unless File.exist?(file)
            vb.customize ['createmedium', 'disk', '--filename', file,
                          '--size', size_mb.to_s, '--format', 'VDI']
          end
          # bento/ubuntu-26.04 boots off a VirtIO SCSI controller; attach the
          # extra disks there too (they appear as /dev/sdb..sdf in port order).
          # Port 0 is the OS disk; extra disks start at port 1.
          vb.customize ['storageattach', :id,
                        '--storagectl', 'VirtIO Controller',
                        '--port', (idx + 1).to_s, '--device', '0',
                        '--type', 'hdd', '--medium', file]
        end
      end
    end
  end
end
